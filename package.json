{
  "name": "blewright",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:android",
    "build:android": "esbuild android/simulatorble/agent.js --bundle --format=iife --platform=neutral --target=es2020 --outfile=dist/android/agent.js",
    "build:probe": "python3 tests/android/build_probe.py",
    "build:host": "python3 tests/android/build_host.py",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "serve": "node mac/service/main.js",
    "android:run": ".venv/bin/python android/launcher/run.py",
    "verify:android": ".venv/bin/python tests/e2e/verify_rpc.py",
    "build:ios": "python3 tests/ios/build_probe.py",
    "verify:ios": "python3 tests/e2e/verify_ios.py",
    "check:ios-protocol": "python3 ios/tools/generate_protocol.py --check",
    "serve:office": "BLEWRIGHT_BACKEND=esp32-scan BLEWRIGHT_PORT=8766 node mac/service/main.js"
  },
  "devDependencies": {
    "buffer": "6.0.3",
    "esbuild": "0.25.12",
    "frida-java-bridge": "7.0.9"
  }
}
